<mxfile host="app.diagrams.net"><diagram id="estados" name="Estados del proceso"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="&lt;b&gt;Diagrama de transici&#243;n de estados del proceso&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Cada flecha es un m&#233;todo de la clase Proceso; cualquier otra transici&#243;n lanza TransicionInvalidaError&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="760" height="45" as="geometry"/></mxCell><mxCell id="ini" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#7EA6E0;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="142" width="110" height="60" as="geometry"/></mxCell><mxCell id="nuevo" value="NUEVO" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#B5739D;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="142" width="170" height="60" as="geometry"/></mxCell><mxCell id="espera" value="ESPERANDO MEMORIA" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#B5739D;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="325" width="190" height="60" as="geometry"/></mxCell><mxCell id="listo" value="LISTO" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#B5739D;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="142" width="170" height="60" as="geometry"/></mxCell><mxCell id="ejec" value="EJECUTANDO" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#B5739D;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="142" width="170" height="60" as="geometry"/></mxCell><mxCell id="bloq"