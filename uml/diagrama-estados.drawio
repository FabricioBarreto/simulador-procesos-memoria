geStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.25;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="espera" target="listo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="582" y="355"/></Array></mxGeometry></mxCell><mxCell id="s5" value="despachar()" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="listo" target="ejec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="expulsar() [quantum agotado y otros Listos]" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ejec" target="listo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s7" value="ejecutarTick()&lt;br&gt;[se dispara la E/S]" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ejec" target="bloq"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="355"/></Array></mxGeometry></mxCell><mxCell id="s8" value="avanzarBloqueo()&lt;br&gt;[bloqueo = 0]" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.75;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bloq" target="listo"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="667" y="355"/></Array></mxGeometry></mxCell><mxCell id="s9" value="ejecutarTick()&lt;br&gt;[CPU restante = 0]" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ejec" target="term"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s10" value="" style="endArrow=block;endFill=1;endSize=8;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="term" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="nota" value="&lt;b&gt;finalizar()&lt;/b&gt; (finalizaci&#243;n forzada): desde cualquier estado menos TERMINADO pasa directo a TERMINADO.&lt;br&gt;Ejecutando + &lt;i&gt;renovarQuantum()&lt;/i&gt;: se queda en EJECUTANDO (no hay cambio de estado)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="480" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>