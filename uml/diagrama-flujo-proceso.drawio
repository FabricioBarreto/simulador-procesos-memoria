<mxfile host="app.diagrams.net"><diagram id="flujo" name="Ciclo de vida del proceso"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="&lt;b&gt;Ciclo de vida de un proceso&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Diagrama de flujo de los estados (NUEVO, ESPERANDO MEMORIA, LISTO, EJECUTANDO, BLOQUEADO, TERMINADO)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="-40" width="700" height="45" as="geometry"/></mxCell><mxCell id="ini" value="Se registra un proceso" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#7EA6E0;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="35" width="230" height="70" as="geometry"/></mxCell><mxCell id="nuevo" value="Queda en estado NUEVO" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#B5739D;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="525" y="139" width="250" height="62" as="geometry"/></mxCell><mxCell id="hueco" value="&#191;Hay un hueco&lt;br&gt;de memoria&lt;br&gt;suficiente?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#97F097;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="260" height="140" as="geometry"/></mxCell><mxCell id="espera" value="Esperar memoria (ESPERANDO MEMORIA)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#B5739D;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="205" y="269" width="250" height="62" as="geometry"/></mxCell><mxCell id="asignar" value="Asignar el bloque y pasar a LISTO" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#B5739D;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="875" y="269" width="2